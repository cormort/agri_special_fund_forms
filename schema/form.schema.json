{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cormort/agri_special_fund_forms/schema/form.schema.json",
  "title": "農業特別收入基金 表單定義",
  "type": "object",
  "required": ["schemaVersion", "id", "meta", "columns", "funds", "tables"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "meta": {
      "type": "object",
      "required": ["title", "year"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "year": { "type": "string", "pattern": "^\\d{3}$" },
        "org": { "type": "string" },
        "formCodes": { "type": "array", "items": { "type": "string" } },
        "units": {
          "type": "object",
          "properties": {
            "amount": { "type": "string" },
            "headcount": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "officialFile": { "type": "string" },
            "profile": { "type": "string" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "levelLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "columns": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "type"],
        "properties": {
          "label": { "type": "string" },
          "type": { "enum": ["number", "text", "textarea", "level"] },
          "tdClass": { "type": "string" },
          "auto": { "enum": ["dep_app", "gov_app"] }
        }
      }
    },
    "funds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "code", "name", "rank"],
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "short": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suffix", "label"],
        "properties": {
          "suffix": { "enum": ["src", "use"] },
          "label": { "type": "string" }
        }
      }
    },
    "tabs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "suffix", "reviewKey"],
        "properties": {
          "id": { "type": "string" },
          "suffix": { "type": "string" },
          "reviewKey": { "type": ["string", "null"] }
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "recalcRow": { "type": "object" },
        "planSumFields": { "type": "array", "items": { "type": "string" } },
        "planSumRule": { "type": "string" },
        "noAutoSumKeywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "cols", "hasLevel"],
        "properties": {
          "id": { "type": "string", "pattern": "^(plan|personnel_cost|control)_[a-z]+(_src|_use)?$|^headcount$" },
          "title": { "type": "string" },
          "sheetId": { "type": "string" },
          "unit": { "type": "string" },
          "cols": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "hasLevel": { "type": "boolean" },
          "reviewKey": { "type": ["string", "null"] },
          "isPlan": { "type": "boolean" },
          "fundId": { "type": "string" },
          "fundCode": { "type": ["string", "null"] },
          "fundName": { "type": "string" },
          "fundShort": { "type": "string" },
          "section": { "enum": ["src", "use"] },
          "sectionLabel": { "type": "string" },
          "rank": { "type": "integer" }
        }
      }
    }
  }
}
